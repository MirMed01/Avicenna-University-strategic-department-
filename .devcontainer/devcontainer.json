{
  "name": "Канон — показ",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "containerEnv": {
    "KANON_DEBUG": "1",
    "KANON_ALLOWED_HOSTS": ".app.github.dev,localhost,127.0.0.1",
    "KANON_CSRF_ORIGINS": "https://*.app.github.dev,https://localhost:8000"
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Канон", "onAutoForward": "openBrowser" }
  }
}
