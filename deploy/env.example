# Скопировать в /etc/kanon/kanon.env (права 600, владелец root) и заполнить. В git настоящий файл НЕ класть.
KANON_SECRET_KEY=сюда-длинный-случайный-ключ
KANON_DATABASE_URL=postgres://kanon:ПАРОЛЬ_БАЗЫ@127.0.0.1:5432/kanon
KANON_ALLOWED_HOSTS=qanun.tajmedun.tj
KANON_CSRF_ORIGINS=https://qanun.tajmedun.tj
KANON_PUBLIC_URL=https://qanun.tajmedun.tj
KANON_MEDIA_ROOT=/srv/kanon/media
# KANON_HSTS_SECONDS=31536000   # включить через 1–2 недели стабильной работы по HTTPS
