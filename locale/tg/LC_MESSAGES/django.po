msgstr "Чораҳои беҳбудӣ: %(t)s"

msgid "Итоги по стандартам"
msgstr "Натиҷаҳо аз рӯи стандартҳо"

#, python-format
msgid ""
"%(code)s. %(title)s: сильных — %(s)s, удовлетворительных — %(sat)s, "
"предполагают улучшение — %(i)s, неудовлетворительных — %(u)s, не оценено — "
"%(n)s."
msgstr ""
"%(code)s. %(title)s: қавӣ — %(s)s, қаноатбахш — %(sat)s, беҳбудиро талаб "
"мекунанд — %(i)s, ғайриқаноатбахш — %(u)s, баҳо дода нашудааст — %(n)s."

msgid "IV. Заключение комиссии по самооценке"
msgstr "IV. Хулосаи комиссия оид ба худбаҳодиҳӣ"

msgid "№"
msgstr "№"

msgid "Критерий"
msgstr "Критерия"

