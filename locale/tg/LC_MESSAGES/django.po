msgid ""
"Для этой оценки опишите меры по улучшению — так требует структура самоотчёта"
" IAAR."
msgstr ""
"Барои ин баҳо чораҳои беҳбудиро тавсиф кунед — сохтори ҳисоботи худбаҳодиҳии"
" IAAR инро талаб мекунад."

msgid "Кто готовит весь стандарт"
msgstr "Кӣ тамоми стандартро омода мекунад"

msgid "Сильная"
msgstr "Қавӣ"

msgid "Удовлетворительная"
msgstr "Қаноатбахш"

msgid "Предполагает улучшение"
msgstr "Беҳбудиро талаб мекунад"

msgid "Неудовлетворительная"
msgstr "Ғайриқаноатбахш"

