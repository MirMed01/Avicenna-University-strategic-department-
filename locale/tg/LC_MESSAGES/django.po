msgstr "стандарт"

msgid "образовательная программа"
msgstr "барномаи таълимӣ"

msgid "Например: 1-790101 Лечебное дело"
msgstr "Масалан: 1-790101 Корҳои табобатӣ"

msgid "факультет"
msgstr "факултет"

msgid "визит экспертов / окончание действующей аккредитации"
msgstr "ташрифи коршиносон / анҷоми мӯҳлати аккредитатсияи амалкунанда"

msgid "ответственный за подготовку"
msgstr "масъули омодасозӣ"

msgid "подготовка к аккредитации"
msgstr "омодагӣ ба аккредитатсия"

msgid "самооценка"
msgstr "худбаҳодиҳӣ"

msgid "кто готовит"
msgstr "кӣ омода мекунад"

msgid "доказательства"
msgstr "далелҳо"

msgid "Документы, приказы, протоколы, ссылки — что подтверждает соответствие."
msgstr ""
"Ҳуҷҷатҳо, фармонҳо, протоколҳо, истинодҳо — он чи мувофиқатро тасдиқ "
"мекунад."

msgid "обоснование оценки"
msgstr "асосноккунии баҳо"

msgid "меры по улучшению"
msgstr "чораҳои беҳбудӣ"

msgid ""
"Обязательно для оценок «предполагает улучшение» и «неудовлетворительная»."
msgstr "Барои баҳоҳои «беҳбудиро талаб мекунад» ва «ғайриқаноатбахш» ҳатмист."

msgid "название документа"
msgstr "номи ҳуҷҷат"

msgid "файл"
msgstr "файл"

msgid "отказ в аккредитации"
msgstr "рад кардани аккредитатсия"

msgid "аккредитация на 7 лет"
msgstr "аккредитатсия ба мӯҳлати 7 сол"

msgid "аккредитация на 5 лет"
msgstr "аккредитатсия ба мӯҳлати 5 сол"

msgid "аккредитация на 3 года"
msgstr "аккредитатсия ба мӯҳлати 3 сол"

msgid "аккредитация на 1 год"
msgstr "аккредитатсия ба мӯҳлати 1 сол"

#, python-format
msgid "Отчёт по самооценке: %(p)s"
msgstr "Ҳисобот оид ба худбаҳодиҳӣ: %(p)s"

#, python-format
msgid ""
"Стандарт: %(s)s. Заготовка сформирована программой «Канон» %(d)s; текст "
"разделов I и III (введение, SWOT-анализ) и выполнение рекомендаций прошлой "
"аккредитации дописываются вручную."
msgstr ""
"Стандарт: %(s)s. Тарҳ аз ҷониби барномаи «Қонун» %(d)s таҳия шудааст; матни "
"бахшҳои I ва III (муқаддима, таҳлили SWOT) ва иҷрои тавсияҳои аккредитатсияи"
" гузашта дастӣ илова карда мешаванд."

msgid "II. Соответствие стандартам"
msgstr "II. Мувофиқат ба стандартҳо"

#, python-format
msgid "Оценка: %(r)s"
msgstr "Баҳо: %(r)s"

msgid "не оценено"
msgstr "баҳо дода нашудааст"

