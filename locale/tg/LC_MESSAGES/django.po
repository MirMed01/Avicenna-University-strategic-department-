#, python-format
msgid "Исправление: %(text)s"
msgstr "Ислоҳ: %(text)s"

#, python-format
msgid ""
"На повторной проверке «%(title)s» достигает порога уровня кафедры "
"(%(threshold)s)."
msgstr ""
"Дар санҷиши такрорӣ «%(title)s» ба ҳадди меъёри сатҳи кафедра "
"(%(threshold)s) мерасад."

msgid ""
"План создан. В него добавлены типовые мероприятия — проверьте и уточните их."
msgstr ""
"Нақша сохта шуд. Ба он чорабиниҳои намунавӣ илова карда шуданд — онҳоро "
"санҷед ва дақиқ кунед."

#, python-format
msgid "%(ref)s: план"
msgstr "%(ref)s: нақша"

msgid "Мероприятие не добавлено: заполните название и срок."
msgstr "Чорабинӣ илова нашуд: ном ва мӯҳлатро пур кунед."

msgid "Опишите, что сделано (или почему мероприятие отменено)."
msgstr "Тавсиф кунед, ки чӣ иҷро шуд (ё чаро чорабинӣ бекор карда шуд)."

msgid "План подан на утверждение"
msgstr "Нақша ба тасдиқ пешниҳод шуд"

msgid "План утверждён, выполняется"
msgstr "Нақша тасдиқ шуд, иҷро мешавад"

msgid "План возвращён на доработку"
msgstr "Нақша барои такмил баргардонида шуд"

msgid "Мероприятия выполнены, ждёт оценки результативности"
msgstr "Чорабиниҳо иҷро шуданд, баҳодиҳии натиҷабахширо интизор аст"

msgid "Результативно — план закрыт"
msgstr "Натиҷабахш — нақша баста шуд"

msgid "Нерезультативно — план снова выполняется"
msgstr "Бенатиҷа — нақша аз нав иҷро мешавад"

msgid "План отменён"
msgstr "Нақша бекор карда шуд"

msgid "Это действие сейчас недоступно."
msgstr "Ин амал ҳоло дастрас нест."

msgid "Напишите комментарий: почему принято это решение."
msgstr "Шарҳ нависед: чаро ин қарор қабул шуд."

msgid "Чтобы подать план, нужны анализ причины и хотя бы одно мероприятие."
msgstr "Барои пешниҳоди нақша таҳлили сабаб ва ақаллан як чорабинӣ лозим аст."

msgid ""
"Ещё есть невыполненные мероприятия: отметьте каждое как выполненное или "
"отменённое."
msgstr ""
"Ҳанӯз чорабиниҳои иҷронашуда ҳастанд: ҳар якро ҳамчун иҷрошуда ё бекоршуда "
"қайд кунед."

msgid "Ни одно мероприятие не выполнено."
msgstr "Ягон чорабинӣ иҷро нашудааст."

msgid "Повторная проверка назначена. Начните в ней сбор данных."
msgstr "Санҷиши такрорӣ таъин шуд. Дар он ҷамъоварии маълумотро оғоз кунед."

msgid "Проблема качества"
msgstr "Мушкилоти сифат"

msgid "Группа проблем"
msgstr "Гурӯҳи мушкилот"

msgid "Итоги опроса показывать не меньше чем при (ответов)"
msgstr "Натиҷаҳои пурсишро на камтар аз (ҷавоб) нишон додан"

msgid ""
"Значение по умолчанию для новых опросов. Не меньше 3 — иначе можно "
"вычислить, кто что ответил."
msgstr ""
"Қимати пешфарз барои пурсишҳои нав. На камтар аз 3 — вагарна муайян кардан "
"мумкин аст, ки кӣ чӣ ҷавоб дод."

msgid "Опросы студентов"
msgstr "Пурсишҳои донишҷӯён"

msgid "Предупреждать, если ответило меньше (% выданных кодов)"
msgstr "Огоҳ кардан, агар камтар аз (% рамзҳои додашуда) ҷавоб дода бошанд"

msgid "При малой доле ответивших итог может не отражать мнение группы."
msgstr ""
"Агар ҳиссаи ҷавобдиҳандагон кам бошад, натиҷа метавонад фикри гурӯҳро "
"инъикос накунад."

msgid ""
"Сколько незначительных несоответствий по одному разделу норм — повод считать"
" значительным"
msgstr ""
"Чанд номувофиқатии ночиз дар як бахши меъёрҳо — асос барои ҷиддӣ ҳисобидан"

msgid "Программа только предупреждает, решение — за экспертом."
msgstr "Барнома танҳо огоҳ мекунад, қарорро коршинос қабул мекунад."

msgid "Проверки"
msgstr "Санҷишҳо"

msgid "Искать повторяющиеся несоответствия в проверках за последние (лет)"
msgstr ""
"Номувофиқатиҳои такроршавандаро дар санҷишҳои (соли) охир ҷустуҷӯ кардан"

msgid "Предупреждать, если показатель снижается столько лет подряд"
msgstr "Огоҳ кардан, агар нишондиҳанда ин қадар сол пай дар пай паст шавад"

msgid "План проверок: баллов за каждый показатель ниже минимального порога"
msgstr "Нақшаи санҷишҳо: хол барои ҳар нишондиҳандаи пасттар аз ҳадди ақал"

msgid "По последней проверке и последнему опросу кафедры."
msgstr "Аз рӯи санҷиш ва пурсиши охирини кафедра."

msgid "План проверок по риску"
msgstr "Нақшаи санҷишҳо аз рӯи хатар"

msgid "План проверок: баллов за каждый показатель ниже требуемого уровня"
msgstr ""
"Нақшаи санҷишҳо: хол барои ҳар нишондиҳандаи пасттар аз сатҳи талабшаванда"

msgid "План проверок: баллов за каждое повторяющееся несоответствие"
msgstr "Нақшаи санҷишҳо: хол барои ҳар номувофиқатии такроршаванда"

msgid "План проверок: баллов за каждый просроченный план исправления"
